# Copy to `.env` and fill in real values. Never commit `.env`.
#
# --- Run mode ---
ARB_MODE=monitor   # monitor | paper | live

# --- Risk overrides (all optional; defaults live in config/settings.py) ---
# MAX_TRADE_USD=500
# DAILY_LOSS_LIMIT_USD=1000
# MAX_TRADES_PER_DAY=2000
# MAX_CONSECUTIVE_FAILURES=5

# --- Local dashboard (see README "Local dashboard") ---
# DASHBOARD_ENABLED=true
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8420
#
# REQUIRED (both) if DASHBOARD_HOST is anything other than 127.0.0.1 --
# without these, the dashboard has no login and anyone who reaches the
# host:port can switch the bot to `live` and arm real orders. Pick a real
# password, not the placeholder below.
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=change_me_to_a_real_password

# --- CEX credentials: {EXCHANGE_ID}_API_KEY / _SECRET / _PASSPHRASE ---
# EXCHANGE_ID is the uppercased ccxt id (see config/venues.py CEX_VENUES).
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET=your_coinbase_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here

OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ... repeat for every other CEX in config/venues.py (kraken, bybit, kucoin,
# bitget, gate, mexc, htx, bitfinex, bitstamp, gemini, bingx, cryptocom,
# lbank, phemex, woo, deribit).

# --- DEX / on-chain hot wallet ---
# IMPORTANT: use a dedicated hot wallet with LIMITED FUNDS for DEX strategies.
# Never put a main wallet's private key in this bot. See README "Before
# running with real money" for why.
DEX_HOT_WALLET_ADDRESS=0xYourHotWalletAddressHere
DEX_HOT_WALLET_PRIVATE_KEY=your_hot_wallet_private_key_here

# --- On-chain RPC endpoints (used for gas oracle + pool reserve reads) ---
ETH_RPC_URL=https://your-ethereum-rpc-endpoint
ARBITRUM_RPC_URL=https://your-arbitrum-rpc-endpoint
BASE_RPC_URL=https://your-base-rpc-endpoint
POLYGON_RPC_URL=https://your-polygon-rpc-endpoint
BSC_RPC_URL=https://your-bsc-rpc-endpoint
SOLANA_RPC_URL=https://your-solana-rpc-endpoint

# --- DEX aggregator API keys (optional, for routed quotes) ---
ONEINCH_API_KEY=your_1inch_api_key_here
ZEROX_API_KEY=your_0x_api_key_here
JUPITER_API_KEY=your_jupiter_api_key_here
ODOS_API_KEY=your_odos_api_key_here
